{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"color": {
			"palette": [
				{ "slug": "base", "name": "Paper", "color": "#FAF8F4" },
				{ "slug": "surface", "name": "Surface", "color": "#FFFFFF" },
				{ "slug": "contrast", "name": "Slate ink", "color": "#1F2933" },
				{ "slug": "accent", "name": "Ember", "color": "#C4521A" },
				{ "slug": "tint", "name": "Sand", "color": "#F0EAE0" },
				{ "slug": "muted", "name": "Muted", "color": "#5C6670" }
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Fraunces (display)",
					"fontFamily": "Fraunces, Georgia, serif",
					"fontFace": [
						{ "fontFamily": "Fraunces", "fontWeight": "600", "fontStyle": "normal", "src": [ "file:./assets/fonts/fraunces-600.woff2" ] },
						{ "fontFamily": "Fraunces", "fontWeight": "700", "fontStyle": "normal", "src": [ "file:./assets/fonts/fraunces-700.woff2" ] }
					]
				},
				{
					"slug": "body",
					"name": "Inter (body)",
					"fontFamily": "Inter, -apple-system, 'Segoe UI', sans-serif",
					"fontFace": [
						{ "fontFamily": "Inter", "fontWeight": "400", "fontStyle": "normal", "src": [ "file:./assets/fonts/inter-400.woff2" ] },
						{ "fontFamily": "Inter", "fontWeight": "600", "fontStyle": "normal", "src": [ "file:./assets/fonts/inter-600.woff2" ] }
					]
				}
			]
		},
		"layout": { "contentSize": "700px", "wideSize": "1120px" }
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--contrast)" },
		"typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "1.045rem", "lineHeight": "1.65" },
		"elements": {
			"heading": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "600", "lineHeight": "1.18", "letterSpacing": "-0.01em" }
			},
			"h2": { "typography": { "fontSize": "1.7rem" } },
			"h3": { "typography": { "fontSize": "1.22rem" } },
			"link": {
				"color": { "text": "var(--wp--preset--color--accent)" },
				":hover": { "color": { "text": "var(--wp--preset--color--contrast)" } }
			},
			"button": {
				"color": { "background": "var(--wp--preset--color--accent)", "text": "var(--wp--preset--color--surface)" },
				"typography": { "fontWeight": "600", "fontSize": "0.95rem" },
				"border": { "radius": "6px" },
				":hover": { "color": { "background": "var(--wp--preset--color--contrast)" } }
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "700", "fontSize": "1.35rem" }
			},
			"core/quote": {
				"border": { "left": { "color": "var(--wp--preset--color--accent)", "width": "3px", "style": "solid" } },
				"typography": { "fontStyle": "italic" }
			},
			"core/separator": {
				"color": { "text": "#D8D2C6" }
			}
		}
	}
}
